# Chartmetric API
# Rate limit: 1 request/second
# Get access token: curl -d '{"refreshtoken":"<token>"}' -H "Content-Type: application/json" \
#   -X POST https://api.chartmetric.com/api/token
CHARTMETRIC_REFRESH_TOKEN=your_refresh_token_here

# Spotify API — https://developer.spotify.com/
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 — https://developers.google.com/youtube/v3
# Use API key for public read-only queries; OAuth for owned-channel data.
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_CLIENT_SECRETS_FILE=config/youtube_oauth_client.json
YOUTUBE_OAUTH_TOKEN_FILE=config/youtube_oauth_token.json

# Email alerts (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@farolatino.com
SMTP_PASSWORD=
ALERT_FROM_EMAIL=alerts@farolatino.com
ALERT_TO_EMAILS=julio@farolatino.com,mariana@farolatino.com

# WhatsApp alerts (Twilio) — optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ALERT_WHATSAPP_NUMBERS=whatsapp:+521234567890
